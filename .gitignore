# Compilación y ejecutables temporales
build/
dist/
dist_installer/
# Los specs de release se versionan en packaging/; los specs generados localmente
# en la raíz se ignoran.
*.spec
!packaging/*.spec

# Entornos virtuales y dependencias
venv/
env/
__pycache__/
*.pyc

# Archivos de cuarentena y reportes locales
cuarentena/
reportes/
logs/
*.quarantine
*.quarantine.meta
reporte_escaneo.txt

# Claves locales, entorno y configuraciones personales
.env
.env.local
.env.*
!.env.example
data/config.json
data/license.json
data/exclusions.json
data/*.db
data/*.db-wal
data/*.db-shm
data/agent_status.json
data/integrity.json